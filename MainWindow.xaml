<Window x:Class="DecompileTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="textile" Height="520" Width="780" MinHeight="520" MaxHeight="520" MinWidth="780" MaxWidth="780"
        Icon="pack://application:,,,/Resources/logo.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="pack://application:,,,/Resources/CoolveticaRg.otf#Coolvetica"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        AllowDrop="True"
        PreviewDragEnter="Window_DragEnter"
        PreviewDragOver="Window_DragOver"
        PreviewDragLeave="Window_DragLeave"
        PreviewDrop="Window_Drop"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThinScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumb" CornerRadius="4" Background="#55ffffff"
                                Width="6" MinHeight="20"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumb" Property="Background" Value="#99ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8">
                            <Border CornerRadius="4" Background="#18ffffff"/>
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Value="{TemplateBinding Value}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Minimum="{TemplateBinding Minimum}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LogScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Column="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                                       Style="{StaticResource ThinScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowBorder" CornerRadius="8" ClipToBounds="True"
            BorderBrush="#e0e0e0" BorderThickness="1">
        <Border.Clip>
            <RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,780,520"/>
        </Border.Clip>

        <Grid>
            <Grid x:Name="MainGrid" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock x:Name="TitleBarText" Text="textile" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#616161"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ThemeBtn" Click="Theme_Click" Style="{StaticResource IconBtn}"
                                Width="28" Height="28" Background="Transparent" BorderThickness="0"
                                ToolTip="Toggle dark mode" Cursor="Hand" Padding="0">
                            <Grid Width="16" Height="16">
                                <Image x:Name="MoonIcon" Source="Resources/Moon.png"
                                       Width="16" Height="16" Visibility="Visible"/>
                                <Image x:Name="SunIcon" Source="Resources/Sun.png"
                                       Width="16" Height="16" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button x:Name="TelegramBtn" Click="Telegram_Click" Style="{StaticResource IconBtn}"
                                Width="28" Height="28" Background="Transparent" BorderThickness="0"
                                ToolTip="Telegram" Cursor="Hand" Padding="0" Margin="2,0,0,0">
                            <Image Source="Resources/TelegramIcon.png" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="InfoBtn" Click="Info_Click" Style="{StaticResource IconBtn}"
                                Width="28" Height="28" Background="Transparent" BorderThickness="0"
                                ToolTip="About" Cursor="Hand" Padding="0" Margin="2,0,0,0">
                            <Grid Width="16" Height="16">
                                <Image x:Name="InfoLightIcon" Source="Resources/InfoBlack.png"
                                       Width="16" Height="16" Visibility="Visible"/>
                                <Image x:Name="InfoDarkIcon" Source="Resources/InfoWhite.png"
                                       Width="16" Height="16" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button x:Name="MinimizeBtn" Click="Minimize_Click" Style="{StaticResource IconBtn}"
                                Width="32" Height="32" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Padding="0" Margin="2,0,0,0">
                            <Grid Width="16" Height="16">
                                <Image x:Name="RemoveBlackIcon" Source="Resources/removeblack.png"
                                       Width="16" Height="16" Visibility="Visible"/>
                                <Image x:Name="RemoveWhiteIcon" Source="Resources/removewhite.png"
                                       Width="16" Height="16" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button x:Name="CloseBtn" Click="Close_Click" Style="{StaticResource IconBtn}"
                                Width="32" Height="32" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Padding="0" Margin="2,0,0,0">
                            <Grid Width="16" Height="16">
                                <Image x:Name="CloseBlackIcon" Source="Resources/closeblack.png"
                                       Width="16" Height="16" Visibility="Visible"/>
                                <Image x:Name="CloseWhiteIcon" Source="Resources/closewhite.png"
                                       Width="16" Height="16" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="20,10,20,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Textile" FontSize="26" FontWeight="SemiBold"
                                   Foreground="#005fb8"/>
                        <TextBlock x:Name="TitleText" Text=" Decompiler" FontSize="26" FontWeight="SemiBold"
                                   Foreground="#1a1a1a"/>
                    </StackPanel>

                    <Border x:Name="PathCard" Grid.Row="1" Background="#f3f3f3"
                            BorderBrush="#e0e0e0" BorderThickness="1"
                            CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,2">
                                <TextBlock x:Name="DllFileLabel" Text="DLL File" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#1a1a1a"/>
                                <TextBlock x:Name="PathLabel" Text="Select assembly path" FontSize="11"
                                           Foreground="#616161"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="InputBorder" Grid.Column="0" Background="White"
                                        BorderBrush="#d1d1d1" BorderThickness="1" CornerRadius="6">
                                    <TextBox x:Name="DllPathBox"
                                             FontSize="13" Padding="10,8"
                                             VerticalContentAlignment="Center"
                                             AcceptsReturn="False"
                                             Background="Transparent" Foreground="#1a1a1a"
                                             BorderThickness="0"/>
                                </Border>
                                <Button x:Name="BrowseBtn" Grid.Column="1" Style="{StaticResource RoundedButton}"
                                        Content="Browse" Click="Browse_Click"
                                        Margin="8,0,0,0" Padding="16,7" FontSize="13"
                                        Background="#005fb8" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DecompileBtn" Grid.Column="0" Style="{StaticResource RoundedButton}"
                                Content="Decompile"
                                Click="Decompile_Click"
                                Background="#005fb8" Foreground="White"
                                Padding="24,8" FontSize="13" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="OpenFolderBtn" Grid.Column="1" Style="{StaticResource RoundedButton}"
                                Content="Open Folder"
                                Click="OpenFolder_Click"
                                IsEnabled="False" Margin="8,0,0,0"
                                Padding="16,8" FontSize="13"
                                Background="#e0e0e0" Foreground="#616161"
                                BorderThickness="0" Cursor="Hand"/>
                        <TextBlock x:Name="StatusText" Grid.Column="2"
                                   Text="Set .dll / .exe File"
                                   Foreground="#616161" FontSize="12"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border x:Name="LogCard" Grid.Row="3"
                            Background="#f9f9f9"
                            BorderBrush="#e0e0e0" BorderThickness="1"
                            CornerRadius="8" Padding="2">
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource LogScrollViewer}">
                            <TextBlock x:Name="LogBlock"
                                       Foreground="#1a1a1a" FontSize="12"
                                       FontFamily="Consolas, Courier New, monospace"
                                       TextWrapping="Wrap" Padding="12,10"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="20,0,20,10">
                    <TextBlock x:Name="FooterText" Text=".text" HorizontalAlignment="Right"
                               Foreground="#999" FontSize="11"/>
                </Grid>
            </Grid>

            <Border x:Name="DragOverlay"
                    Background="#33005FB8" CornerRadius="8"
                    Opacity="0" IsHitTestVisible="False" Visibility="Collapsed"
                    BorderBrush="#99005FB8" BorderThickness="2">
                <StackPanel x:Name="DragContent" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.RenderTransform>
                        <ScaleTransform x:Name="DragScale" ScaleX="1" ScaleY="1"/>
                    </StackPanel.RenderTransform>
                    <Viewbox x:Name="DragIcon" Width="64" Height="64" Margin="0,0,0,12" HorizontalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="DragIconPath" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Data="M4,2 L14,2 L20,8 L20,22 L4,22 Z M14,2 L14,8 L20,8 M12,18 L12,9 M8,13 L12,9 L16,13"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="DragTitleText" Text="Drop it here" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DragSubText" Text=".dll / .exe" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
